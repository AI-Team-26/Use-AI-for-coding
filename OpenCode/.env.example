# NOTE. this file has to use LF, not CRLF !!
GITHUB_AGENT_ACCOUNT=your GH agent account          (shadow account used by the agent)
GITHUB_ORG=your GH organization
GITHUB_REVIEWER=GH account to be set as reviewer    (can be your account or an agent account)
GITHUB_COMMIT_EMAIL=your GH no-reply email          (GitHub account credited for commits)

GITHUB_AGENT_ACCOUNT_PAT="${GITHUB_AI_AGENT_PAT}"  <-- you can use this to get it from Environment variable
GITHUB_ORG_PAT="${GITHUB_AI_ORG_PAT}"

# For access repositories of main Account (optional)
GITHUB_MAIN_ACCOUNT=your GH account
GITHUB_MAIN_ACCOUNT_PAT="${GITHUB_MAIN_PAT}" 

# 3rd party APIs
EXA_API_KEY=        (not used in this harness)

# OpenCode keys
OPENCODE_API_KEY_1="${OPENCODE_API_KEY_1}"
OPENCODE_API_KEY_2="${OPENCODE_API_KEY_2}"
OPENCODE_API_KEY=$OPENCODE_API_KEY_1  # default