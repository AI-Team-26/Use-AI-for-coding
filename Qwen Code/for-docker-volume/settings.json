  "model": {
    "name": "minimax/minimax-m2.5:free"
  },
 "fastModel": "",
  "experimental": {
    "emitToolUseSummaries": true
  },
  "ui": {
    "theme": "ANSI"
  },
  "tools": {
    "enabled": true,
    "sandbox": false
  },
  "$version": 3,
  "permissions": {
    "allow": [
      "Bash(touch *)",
      "Bash(dotnet *)",
      "Bash(git status)", 
      "Bash(git switch main)",
      "Bash(git pull)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",      
      "Bash(git checkout *)", // single branch
      "Bash(git checkout -b **)", // create + checkout
      "Bash(git checkout --track **)", // track remote
      "Bash(git merge main)",
      "Bash(git add -A)",
      "Bash(git add *)",
      "Bash(git commit -m *)",      
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr view * --json *)",
      "Bash(gh pr view * --comments)",
      "Bash(gh pr view * --json * --comments)",
      //"Bash(gh pr create **)",
      "Bash(gh pr create --title * --body *)",
      "Bash(gh pr create --title * --body * --base * --head *)",
      "WebFetch(**)"
    ],
    "deny": [
        "Bash(rm -rf **)",
        //"Bash(curl **)",
        "Bash(wget **)",
        "Bash(gh api (DELETE|PATCH|POST) **)",
        "Bash(git push --force **)",
        "Bash(git reset --hard **)",
        "Bash(git push origin --delete **)"
    ]
  }
}