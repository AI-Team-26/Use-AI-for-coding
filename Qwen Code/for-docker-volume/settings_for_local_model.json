{
    "model": {
        "name": "qwen2.5-coder:7b-20k",
        "skipStartupContext": true,         
        "maxSessionTurns": 20,          
        "chatCompression": {
            "contextPercentageThreshold": 0.5
        }
    },
    "modelProviders": {
        "openai": {
            "generationConfig": {
                "contextWindowSize": 20480,    
                "samplingParams": {
                    "max_tokens": 2048           
                }
            }
        }
    },
    "memory": {
        "enableManagedAutoMemory": false,   
        "enableManagedAutoDream": false  
    }, 
    "fastModel": "",                 
    "ui": {
        "enableFollowupSuggestions": false    
    },  
    "systemPrompt": "You are a helpful coding assistant.",
    "tools": {
        "sandbox": false
    }
}